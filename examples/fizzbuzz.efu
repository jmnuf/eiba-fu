
fn fizzbuz(n: sisz, target: sisz) {
  if (n > target) return;

  let rem3 := n % 3;
  let rem5 := n % 5;

  if (rem3 == 0) {
    printf(`Fizz');
  }

  if (rem5 == 0) {
    printf(`Buzz');
  }

  if (rem3 != 0) {
    if (rem5 != 0) printf(`%v', n);
  }

  printf(`\n');

  fizzbuz(n + 1, target);
}

fn main() {
  fizzbuz(0, 15);
}

